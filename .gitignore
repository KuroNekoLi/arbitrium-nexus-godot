.godot/
work/
*.import
work/simple-cards-v-2/

# Godot CSV importer artifacts. BattleTranslations parses the CSV sources
# directly at runtime, so generated *.translation binaries are not sources.
*.translation

# IDE / agent workspace state.
.idea/
.vscode/
*.iml

# Local headless capture / QA runs. Evidence is recorded by path + SHA256 in
# docs/handoff backfills; commit curated PNGs explicitly under outputs/ instead.
outputs/p4_input_capture/
outputs/visual_regression/
outputs/retirement_review/
outputs/**/logs/

# OS noise.
Thumbs.db
desktop.ini
.DS_Store

# Python CI helper bytecode generated by local test runs.
__pycache__/
*.pyc

# NOTE: *.uid files are intentionally tracked (Godot 4.4+ recommendation and
# existing repo convention); do not ignore them.

# Godot Git Plugin may leave atomic-replacement copies while loading its
# Windows editor extension. Keep the shipped DLL and import libraries tracked.
addons/godot-git-plugin/**/~libgit_plugin.windows.editor.x86_64.dll*
